<UserControl x:Class="SerialBroker.Gui.SessionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TextElement.Foreground="{DynamicResource InkBrush}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Padding="20,16">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,16,0">
     <TextBlock Text="连接设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
     <StackPanel x:Name="ConfigFields">
      <TextBlock Text="设备备注" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" MaxLength="200" TextChanged="NameChanged"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="物理串口" Style="{StaticResource FieldLabel}"/><Button Grid.Column="2" Content="刷新" Click="RefreshClick" Style="{StaticResource QuietButton}" Padding="5,0" Margin="0,6,0,0" MinHeight="24"/></Grid>
      <ComboBox x:Name="PortBox" IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="DisplayName" SelectedValuePath="Port" MaxDropDownHeight="300" SelectionChanged="PortSelected" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
       <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" MaxWidth="520" ToolTip="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock x:Name="PortDetails" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
      <TextBlock Text="波特率" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BaudBox" IsEditable="True"/>
      <TextBlock Text="Telnet 端口" Style="{StaticResource FieldLabel}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TelnetBox" TextChanged="TelnetEdited"/><CheckBox x:Name="TelnetEnabledBox" Grid.Column="1" Content="启用" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid>
      <TextBlock Text="串口格式" Style="{StaticResource FieldLabel}"/><TextBlock Text="8N1 · 无流控" Foreground="{DynamicResource MutedBrush}"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><CheckBox x:Name="DtrBox" Content="DTR" Margin="0,0,22,0"/><CheckBox x:Name="RtsBox" Content="RTS"/></StackPanel>
      <TextBlock Text="日志根目录" Style="{StaticResource FieldLabel}"/>
     </StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LogBox"/><Button Grid.Column="2" Content="打开" Click="OpenLogsClick" Padding="10,6"/></Grid>
     <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="连接设备" Style="{StaticResource PrimaryButton}" Click="StartClick"/><Button x:Name="StopButton" Grid.Column="2" Content="断开" Click="StopClick" IsEnabled="False"/></Grid>
     <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20,0,14"/>
     <TextBlock Text="写入策略" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
     <ComboBox x:Name="PolicyBox" SelectedIndex="2" SelectionChanged="PolicyChanged" IsEnabled="False"><ComboBoxItem Content="全部只读"/><ComboBoxItem Content="单写入者"/><ComboBoxItem Content="共享写入"/></ComboBox>
     <TextBlock Text="客户端" Style="{StaticResource FieldLabel}"/>
     <ListBox x:Name="ClientsBox" Height="96" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource LineBrush}"/>
     <Button x:Name="DisconnectButton" Content="断开选中客户端" Click="DisconnectClick" Style="{StaticResource QuietButton}" Margin="0,8,0,0" IsEnabled="False"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="设备监视" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="PauseBox" Content="暂停显示" Margin="0,0,16,0" VerticalAlignment="Center"/><CheckBox x:Name="HexBox" Content="HEX" Margin="0,0,12,0" VerticalAlignment="Center" Checked="RenderModeChanged" Unchecked="RenderModeChanged"/><Button x:Name="ClearButton" Content="清空" Style="{StaticResource QuietButton}" Click="ClearClick" MinHeight="28" Padding="10,3"/></StackPanel></Grid>
    <TextBlock x:Name="StatusText" Grid.Row="1" Text="尚未连接" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,12"/>
    <Grid Grid.Row="2" Margin="8,0,8,8"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="时间" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Grid.Column="1" Text="方向" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Grid.Column="2" Text="内容" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
    <ListBox x:Name="MonitorBox" Grid.Row="3" BorderThickness="0" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource InkBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" FontFamily="Cascadia Mono, Consolas" FontSize="12">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Direction}" FontWeight="SemiBold" Foreground="{Binding Color}"/><TextBlock Grid.Column="2" Text="{Binding Text}"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="CountersText" Text="RX  0 B       TX  0 B" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas"/><TextBlock x:Name="EndpointText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>
